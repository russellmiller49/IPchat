      "bronchial artery damage",
      "older age (>60 years)",
      "male sex",
      "diabetes mellitus",
      "hypoalbuminemia/poor nutrition",
      "heavy smoking/COPD",
      "prolonged postoperative steroids",
      "preoperative respiratory failure",
      "cirrhosis",
      "Haemophilus influenzae in sputum",
      "postoperative mechanical ventilation >24 h"
    ],
    "decreases": [
      "adequate stump length and buttressing",
      "infection control with drainage",
      "nutritional optimization"
    ],
    "notes": "Right pneumonectomy carries ~3× higher risk vs left; neoadjuvant radiotherapy increases risk; lobectomy risk ~0.5–1% vs pneumonectomy 4.5–20%."
