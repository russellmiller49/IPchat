  "clinical_guidelines": [
    {
      "recommendation": "VATS should be attempted in all feasible patients with stage II/III empyema if single-lung ventilation is tolerated. Conversion to thoracotomy is reserved for stage III empyema, prolonged symptoms, or gram-negative organisms.",
      "source": "pdf",
      "page": 4
    },
    {
      "recommendation": "Open thoracic window is reserved for chronic or refractory empyema cases, often post-pneumonectomy or when bronchopleural fistula is present.",
      "source": "pdf",
      "page": 4
    },
    {
      "recommendation": "Enhanced Recovery After Surgery (ERAS) protocols should be implemented pre-, intra-, and post-operatively to reduce complications, air leaks, and length of stay.",
      "source": "pdf",
      "page": 6
    }
  ],
