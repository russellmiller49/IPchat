# Lite Edition - Lightweight Bronchmonkey without database
FROM python:3.11-slim

WORKDIR /app

# Install minimal system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY pyproject.toml .
COPY ipchat/ ./ipchat/

# Install with lite extras
RUN pip install --no-cache-dir -e ".[lite]"

# Copy data (indexes only, no DB)
COPY data/index/ ./data/index/
COPY data/oe_final_outputs/ ./data/oe_final_outputs/

# Expose UI port only
EXPOSE 8501

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Run lite edition
CMD ["ipchat", "run", "--edition", "lite", "--ui", "streamlit"]