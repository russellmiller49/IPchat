# Hugging Face Space Edition
FROM python:3.11-slim

# Create app user
RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH

WORKDIR $HOME/app

# Copy as user
COPY --chown=user . .

# Install dependencies
RUN pip install --no-cache-dir --user -e ".[space]"

# Space uses port 7860
EXPOSE 7860

# Environment for Space
ENV IPCHAT_EDITION=space \
    STREAMLIT_SERVER_PORT=7860 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Run space app
CMD ["python", "-m", "streamlit", "run", "ipchat/apps/space_app.py", \
     "--server.port", "7860", \
     "--server.address", "0.0.0.0", \
     "--server.enableCORS", "false", \
     "--server.enableXsrfProtection", "false"]